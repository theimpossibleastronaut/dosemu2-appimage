#!/usr/bin/env bash
# AppImage entry point for dosemu2.
#
# The PPA's /usr/bin/dosemu launcher script has /usr/libexec, /usr/lib/dosemu
# and /usr/share/dosemu hardcoded at deb build time, so it can't find its
# files when the AppImage is mounted at /tmp/.mount_XXXXXX. We bypass it and
# invoke dosemu2.bin directly, redirecting every absolute-path lookup the
# binary does to the mounted AppDir via --F* flags and env vars.
#
# dosemu2.bin itself has its rpath patched by build-appimage.sh so it can
# find libdosemu2.so.0.1 and other bundled libs without LD_LIBRARY_PATH —
# avoiding the AppDir's older libreadline/libtinfo leaking into child
# shells dosemu2 spawns.

set -e

HERE="$(readlink -f "$(dirname "$0")")"

DOSEMU_BIN="$HERE/usr/libexec/dosemu2/dosemu2.bin"

# Plugin .so files (libplugin_*.so). PPA puts these at /usr/lib/dosemu;
# multi-arch builds sometimes use /usr/lib/<triplet>/dosemu instead.
PLUGINDIR="$HERE/usr/lib/dosemu"
if [ ! -d "$PLUGINDIR" ]; then
  alt=$(find "$HERE/usr/lib" -maxdepth 2 -type d -name dosemu 2>/dev/null | head -1)
  [ -n "$alt" ] && PLUGINDIR="$alt"
fi

# --Flibdir = "keymap and FreeDOS location" per `dosemu2.bin --help`.
# dosemu2 auto-derives the commands dir (dosemu2-cmds-X.Y/) and FreeDOS
# subdirs from this, so no separate --Fcmddir is needed.
LIBDIR="$HERE/usr/share/dosemu"

# Point dosemu2 at comcom32 (the 32-bit DOS shell) rather than comcom64.
# comcom64 needs the dj64 runtime, which has /usr/i386-pc-dj64/lib/crt0.elf
# hardcoded in libdjstub64.so — that absolute path is unreachable from
# inside the AppImage mount and there's no env var to override it.
# comcom32 uses plain DPMI and works without dj64.
export DOSEMU2_COMCOM_DIR="$HERE/usr/share/comcom32"

# fdpp's kernel ELF (fdppkrnl.XX.YY.elf) is otherwise looked up at the
# hardcoded /usr/share/fdpp, which isn't where the AppImage mounts it.
export FDPP_KERNEL_DIR="$HERE/usr/share/fdpp"

# Translate launcher-style flags to their dosemu2.bin equivalents. The PPA's
# /usr/bin/dosemu shell wrapper would normally do this; since we bypass it,
# the most common user-facing flags need explicit handling here. Anything
# else is passed straight through to the binary.
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -dumb)
      ARGS+=(-td -ks)
      shift
      ;;
    -quiet)
      ARGS+=(-tde -ks)
      exec 2>/dev/null
      shift
      ;;
    -home)
      ARGS+=(-d "$HOME:R")
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

exec "$DOSEMU_BIN" \
  --Flibdir "$LIBDIR" \
  --Fplugindir "$PLUGINDIR" \
  "${ARGS[@]}"
