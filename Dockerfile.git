# syntax=docker/dockerfile:1.6
#
# Two-stage build on Arch Linux:
#   builder — installs build deps via pacman, bootstraps paru-bin, then uses
#             paru to resolve and build the AUR helpers dosemu2 needs
#             (libsearpc + fdpp + dj64-git + comcom64-git plus their
#             transitive AUR deps — djgpp toolchain, djstub-git, etc.).
#             Compiles dosemu2 itself from upstream git into /install (via
#             `make install DESTDIR`).
#   runtime — fresh Arch image with only the runtime packages, the four
#             target .pkg.tar.zst files installed via pacman -U, and
#             dosemu2's install tree copied over from the builder. Make-only
#             AUR deps stay behind in the builder layer.
#
# The pacman package list mirrors the depends/makedepends arrays of the AUR
# dosemu2-git PKGBUILD, adjusted for upstream's SDL3 requirement.

# ---------------------------------------------------------------------------
# Stage 1: builder
# ---------------------------------------------------------------------------
FROM archlinux:base-devel AS builder

ARG DOSEMU2_REF=devel
ARG DOSEMU2_REPO=https://github.com/dosemu2/dosemu2.git
# Build parallelism. Empty = auto-detect via nproc at build time. Override
# with `--build-arg JOBS=8` (or via compose) if buildkit's cgroup limits
# make nproc return a smaller number than you'd like.
ARG JOBS=

# Refresh pacman db. base-devel already has gcc, make, autoconf, automake,
# binutils, bison, flex, sed, perl, etc. Layer in the project-specific deps.
RUN pacman -Syu --noconfirm --needed \
        git sudo bash unzip upx \
        fontconfig libb64 libieee1284 libslirp json-c jansson readline \
        libcap libxext libx11 acl alsa-lib glib2 \
        sdl3 slang libao fluidsynth ladspa gpm \
 && pacman -Scc --noconfirm

# makepkg refuses to run as root, so we need a build user with passwordless
# sudo for pacman (used internally by makepkg --syncdeps / --install).
RUN useradd -m -G wheel -s /bin/bash builder \
 && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder

# Persist build parallelism for every downstream build tool:
#   * /etc/makepkg.conf — makepkg overrides MAKEFLAGS from its own config,
#     so this is the *only* way to parallelize the AUR build loop's makes.
#   * /etc/dosemu2-jobs.env — sourced by later RUNs to export MAKEFLAGS
#     (direct `make` calls) and CARGO_BUILD_JOBS (cargo invocations, both
#     standalone and those reached through makepkg, which inherits env).
#   * /home/builder/.cargo/config.toml — belt-and-suspenders for cargo in
#     case a PKGBUILD scrubs CARGO_BUILD_JOBS.
RUN J="${JOBS:-$(nproc)}" \
 && echo "Configuring builds for -j${J}" \
 && sed -i "s|^#MAKEFLAGS=.*|MAKEFLAGS=\"-j${J}\"|" /etc/makepkg.conf \
 && printf 'MAKEFLAGS=-j%s\nCARGO_BUILD_JOBS=%s\n' "${J}" "${J}" \
        > /etc/dosemu2-jobs.env \
 && install -d -o builder -g builder /home/builder/.cargo \
 && printf '[build]\njobs = %s\n' "${J}" > /home/builder/.cargo/config.toml \
 && chown builder:builder /home/builder/.cargo/config.toml

USER builder
WORKDIR /home/builder

# Bootstrap paru via plain makepkg. We use the source PKGBUILD (not the
# `-bin` variant) because paru-bin ships a prebuilt binary linked against a
# specific libalpm.so version, which breaks whenever rolling Arch bumps
# pacman's ABI. Source paru is a Rust compile against the currently
# installed libalpm — slow once, but stable. Then paru resolves the AUR
# dep graph for libsearpc/fdpp/dj64-git/comcom64-git (which transitively
# pull in djgpp-gcc, djgpp-binutils, djstub-git, thunk_gen-git, smallerc,
# lfanew-git, nasm-segelf-git, i386-elf-binutils — long enough that
# hand-ordering it is fragile).
RUN . /etc/dosemu2-jobs.env && export MAKEFLAGS CARGO_BUILD_JOBS \
 && git clone --depth=1 https://aur.archlinux.org/paru.git /tmp/paru \
 && (cd /tmp/paru && makepkg --noconfirm --syncdeps --install --needed --clean)

RUN . /etc/dosemu2-jobs.env && export MAKEFLAGS CARGO_BUILD_JOBS \
 && paru -S --noconfirm --needed --skipreview \
        libsearpc dj64-git fdpp comcom64-git

# Collect just the four packages we actually need at runtime — paru's
# cache also holds make-only deps (djgpp toolchain, etc.) we don't want
# bloating the runtime image. The [0-9] in the glob skips debug subpkgs.
RUN sudo mkdir -p /pkgs \
 && for pkg in libsearpc dj64-git fdpp comcom64-git; do \
        sudo find /home/builder/.cache/paru/clone -maxdepth 3 \
             -name "${pkg}-[0-9]*.pkg.tar.zst" \
             -exec cp -t /pkgs {} + ; \
    done

# Compile dosemu2 from upstream git. MAKEFLAGS/CARGO_BUILD_JOBS come from
# the shared env file set up before USER builder.
RUN . /etc/dosemu2-jobs.env && export MAKEFLAGS CARGO_BUILD_JOBS \
 && git clone "${DOSEMU2_REPO}" /tmp/dosemu2 \
 && cd /tmp/dosemu2 \
 && git checkout "${DOSEMU2_REF}" \
 && ./autogen.sh \
 && ./default-configure \
 && make

# Stage the dosemu2 install tree. /pkgs was already populated above.
USER root
RUN cd /tmp/dosemu2 && make install DESTDIR=/install

# ---------------------------------------------------------------------------
# Stage 2: runtime
# ---------------------------------------------------------------------------
FROM archlinux:latest

# Runtime libraries only — no compilers, no -devel packages. fdpp, dj64,
# and comcom64 come from the builder-produced packages below; everything
# else is in the default Arch repos.
RUN pacman -Syu --noconfirm --needed \
        bash sudo \
        fontconfig libb64 libieee1284 libslirp json-c jansson readline \
        libcap libxext libx11 acl alsa-lib glib2 libelf \
        sdl3 slang libao fluidsynth ladspa gpm \
        glibc-locales \
 && pacman -Scc --noconfirm

# Arch ships no locales by default; uncomment en_US.UTF-8 and generate it
# so dosemu's $_external_char_set autodetect is happy.
RUN sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
 && locale-gen

# Install the four AUR-built runtime packages (libsearpc, dj64-git, fdpp,
# comcom64-git). pacman -U handles their interdependencies as long as all
# four files are passed at once.
COPY --from=builder /pkgs/ /tmp/pkgs/
RUN pacman -U --noconfirm /tmp/pkgs/*.pkg.tar.zst \
 && rm -rf /tmp/pkgs

# Drop dosemu2's install tree over the root filesystem.
COPY --from=builder /install/ /

# make install lands libdosemu2.so.0.1 in /usr/local/lib, which is not on
# Arch's default ld.so search path. Register it and refresh the cache.
RUN echo /usr/local/lib > /etc/ld.so.conf.d/dosemu2.conf && ldconfig

RUN useradd -m -s /bin/bash dosuser \
 && install -d -o dosuser -g users /home/dosuser/.dosemu

USER dosuser
WORKDIR /home/dosuser

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TERM=xterm-256color

ENTRYPOINT ["dosemu"]
