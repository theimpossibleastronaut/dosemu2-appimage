# Build-environment image for the AppImage build (build-appimage.sh).
#
# Parameterized by BASE so one Dockerfile produces both arches, matching
# Dealer's Choice's anylinux build-env pattern:
#   amd64 <- archlinux:latest   (official Arch, x86_64 only)
#   arm64 <- lopsided/archlinux (community Arch Linux ARM)
ARG BASE=archlinux:latest
FROM ${BASE}

# pacman 7.0's download sandbox (Landlock + the 'alpm' DownloadUser) cannot be
# applied inside the CI container, so any pacman call that actually retrieves
# packages aborts ("switching to sandbox user 'alpm' failed"). Disable it for
# every pacman invocation, including the get-debloated-pkgs / quick-sharun
# calls that run at AppImage build time.
RUN sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf

# Build + runtime deps for dosemu2 and its toolchain, plus the
# AppImage-bundling tools (patchelf/wget/zsync). autoconf-archive is a
# dj64dev makedepend. The trailing -Rdd removes the 217 MB of mesa/LLVM
# sdl3 drags in via libglvnd: build-appimage.sh puts mesa-nano in their
# place before dosemu2 is configured. It has to be in this layer, since a
# later RUN would grow the image rather than shrink it.
RUN pacman -Syu --noconfirm --needed \
        base-devel \
        git \
        meson \
        ninja \
        cmake \
        nasm \
        pkgconf \
        elfutils \
        automake \
        autoconf \
        autoconf-archive \
        libtool \
        texinfo \
        ctags \
        jansson \
        glib2 \
        json-c \
        libslirp \
        libseccomp \
        alsa-lib \
        # alsa-lib dlopens its pulse/pipewire backends from a compiled-in
        # module dir; without them a host whose alsa config routes through
        # PulseAudio gets an error and falls back to a busy hw device.
        alsa-plugins \
        pipewire-alsa \
        fluidsynth \
        ladspa \
        gpm \
        libsamplerate \
        vde2 \
        libx11 \
        libxext \
        # Without these the X plugin (which needs both mkfontdir and
        # bdftopcf to build its fonts) and the ieee1284 one die in
        # configure and never reach the bundle. libao is deliberately
        # absent: it dlopens its backends from a compiled-in
        # /usr/lib/ao/plugins-4 with no env override, so a bundled copy
        # can never reach them and the plugin only ever printed "unable
        # to open output device". alsa and sdl already cover output.
        xorg-mkfontscale \
        xorg-bdftopcf \
        libieee1284 \
        sdl3 \
        sdl3_ttf \
        fontconfig \
        libb64 \
        readline \
        slang \
        patchelf \
        wget \
        zsync \
  && pacman -Rdd --noconfirm mesa llvm-libs \
  && rm -rf /var/cache/pacman/pkg/*

# ---------------------------------------------------------------------------
# dosemu2's toolchain, built from source and pinned to a commit — the same
# components and pins as theimpossibleastronaut/dosemu2-container's Alpine
# chain (Dockerfile.02-binutils / Dockerfile.03-toolchain), rebuilt here
# against glibc instead of musl.
#
# Every component installs to --prefix=/usr, not the /usr/local default.
# Arch's pkg-config does not search /usr/local/lib/pkgconfig, so fdpp's
# `dependency('thunk_gen')` would silently miss it and fall back to its
# bundled copy, which trips a custom_target(depends:) type error on
# meson >=1.11.
# ---------------------------------------------------------------------------

# The i686-linux-gnu-ld symlink is what fdpp looks for. Its
# fdpp/kernel/meson.build searches ['i686-linux-gnu-ld', 'i386-elf-ld',
# 'x86_64-linux-gnu-ld', 'ld.bfd'] for the linker it calls with
# `-melf_i386`, and the triplet built here is not in that list. On x86_64
# the fallback ld.bfd handles elf_i386 anyway, so the miss is invisible;
# on aarch64 it fails with "unrecognised emulation mode: elf_i386".
ARG BINUTILS_REF=binutils-2_47
RUN git clone --depth 1 --branch "${BINUTILS_REF}" \
        git://sourceware.org/git/binutils-gdb.git /root/binutils-gdb \
 && cd /root/binutils-gdb \
 && ./configure --prefix=/usr --target=i686-unknown-linux-gnu \
        --disable-gdb --disable-texinfo --disable-sim --disable-gprofng \
 && make -j"$(nproc)" \
 && make install-strip \
 && ln -s i686-unknown-linux-gnu-ld /usr/bin/i686-linux-gnu-ld \
 && rm -rf /root/binutils-gdb

ARG THUNK_GEN_REF=4967a317e97167640d524f66860908fcb0d88fa8
ARG FDPP_REF=3c2dd80cc1ca152d26e35539c821cc7086537023
ARG SMALLERC_REF=1865d79ce7a5ad3f8a9515a571437cee084b8b1d
ARG DJSTUB_REF=f002e47f1d579e52e5162efbe8ae3e6308c67258
ARG DJ64DEV_REF=fc40c12a481c44fa19757dfd753962157281d390
ARG COMCOM64_REF=7d72f64bf327fb78f504498ac81e21bd57368904
ARG LIBSEARPC_REF=23d5df62815fb3b7825bf4e1a28b29af701e8cb2

RUN mkdir -p /root/thunk_gen && cd /root/thunk_gen \
 && git init -q && git remote add origin https://github.com/stsp/thunk_gen.git \
 && git fetch -q --depth 1 origin "${THUNK_GEN_REF}" && git checkout -q FETCH_HEAD \
 && meson setup --prefix=/usr --buildtype=plain build \
 && meson compile -C build \
 && meson install -C build \
 && rm -rf /root/thunk_gen

RUN mkdir -p /root/fdpp && cd /root/fdpp \
 && git init -q && git remote add origin https://github.com/dosemu2/fdpp.git \
 && git fetch -q --depth 1 origin "${FDPP_REF}" && git checkout -q FETCH_HEAD \
 && ./configure.meson -- --prefix /usr \
 && meson compile --verbose -C build \
 && meson install -C build \
 && rm -rf /root/fdpp

# smallerc's own configure/Makefile default to /usr/local; its AUR
# PKGBUILD patches common.mk's `prefix` line before building rather
# than passing a flag (there's no configure --prefix option).
RUN mkdir -p /root/smallerc && cd /root/smallerc \
 && git init -q && git remote add origin https://github.com/alexfru/smallerc.git \
 && git fetch -q --depth 1 origin "${SMALLERC_REF}" && git checkout -q FETCH_HEAD \
 && sed -i -e '/^prefix =/ s:/usr/local:/usr:g' common.mk \
 && ./configure \
 && make \
 && make install \
 && rm -rf /root/smallerc

# djstub's Makefile also hardcodes /usr/local in PREFIX/prefix
# assignments; same sed fix its AUR PKGBUILD applies.
RUN mkdir -p /root/djstub && cd /root/djstub \
 && git init -q && git remote add origin https://github.com/stsp/djstub.git \
 && git fetch -q --depth 1 origin "${DJSTUB_REF}" && git checkout -q FETCH_HEAD \
 && sed -E -e '/^PREFIX ?=/ s:/usr/local:/usr:g' -e '/^prefix ?=/ s:/usr/local:/usr:g' \
        -i Makefile \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /root/djstub

# /usr/i386-pc-dj64 is where libdjstub64.so's compiled-in CRT0 path points,
# read at runtime on every dj64 launch (stub.c: open(CRT0, ...)). Any
# absolute path works as long as build-appimage.sh's PATH_MAPPING covers it
# and crt0.elf lands at the matching relative path. The makefile sed sweep
# (as dj64dev's AUR PKGBUILD does) catches hardcoded /usr/local that
# --prefix misses.
RUN mkdir -p /root/dj64dev && cd /root/dj64dev \
 && git init -q && git remote add origin https://github.com/stsp/dj64dev.git \
 && git fetch -q --depth 1 origin "${DJ64DEV_REF}" && git checkout -q FETCH_HEAD \
 && ./autogen.sh \
 && ./configure --prefix=/usr --disable-32bit --disable-ncurses \
 && grep -rle '/usr/local' --include=makefile --include=Makefile . \
        | xargs -r sed -E -e '/^PREFIX ?=/ s:/usr/local:/usr:g' \
                           -e '/^prefix ?=/ s:/usr/local:/usr:g' -i \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /root/dj64dev

# comcom64's src/makefile.inc supports overriding prefix via a PREFIX
# make variable directly (a Termux-compat path: ifneq($(PREFIX),)),
# which is simpler and less brittle than sed-patching its makefiles —
# and unlike the sed sweep used for the other components, avoids
# needing to match makefile.inc as well as makefile/Makefile.
RUN mkdir -p /root/comcom64 && cd /root/comcom64 \
 && git init -q && git remote add origin https://github.com/dosemu2/comcom64.git \
 && git fetch -q --depth 1 origin "${COMCOM64_REF}" && git checkout -q FETCH_HEAD \
 && make PREFIX=/usr static -j"$(nproc)" \
 && make PREFIX=/usr install_64 \
 && rm -rf /root/comcom64

RUN mkdir -p /root/libsearpc && cd /root/libsearpc \
 && git init -q && git remote add origin https://github.com/haiwen/libsearpc.git \
 && git fetch -q --depth 1 origin "${LIBSEARPC_REF}" && git checkout -q FETCH_HEAD \
 && ./autogen.sh \
 && ./configure --prefix=/usr PYTHON=/usr/bin/python \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /root/libsearpc

# libmt32emu is AUR-only, so the munt (MT-32) plugin has no packaged
# dependency to install. CMAKE_POLICY_VERSION_MINIMUM is needed because
# munt still declares cmake_minimum_required(2.8.12), which cmake 4
# refuses outright. The plugin only registers itself when the user points
# $_munt_roms at MT-32 ROMs, which are proprietary and not shipped here,
# so this costs a 375 KB library and adds no output for anyone else.
ARG MUNT_REF=munt_2_8_2
RUN git clone --depth 1 --branch "${MUNT_REF}" \
        https://github.com/munt/munt.git /root/munt \
 && cmake -S /root/munt/mt32emu -B /root/munt/build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DBUILD_SHARED_LIBS=ON -Dlibmt32emu_BUILD_TESTING=FALSE \
 && cmake --build /root/munt/build -j"$(nproc)" \
 && cmake --install /root/munt/build \
 && rm -rf /root/munt

# Without a soundfont on the host, dosemu2 prints "soundfonts not found"
# on every start and MIDI is silent. Vintage Dreams Waves is 314 KB; its
# licence allows redistribution unmodified provided the copyright notice
# travels with it, hence COPYRIGHT.txt. /usr/share/soundfonts/default.sf2
# is both fluidsynth's compiled-in default and the first path dosemu2
# looks in.
ARG SOUNDFONT_REF=v2.4.6
RUN mkdir -p /usr/share/soundfonts && cd /usr/share/soundfonts \
 && sf=https://raw.githubusercontent.com/FluidSynth/fluidsynth/${SOUNDFONT_REF}/sf2 \
 && wget -q "$sf/VintageDreamsWaves-v2.sf2" "$sf/COPYRIGHT.txt" \
 && printf '%s  %s\n' \
      52132b2b83994f0067d3a66b93b4f1b67d53ff8c0d3be90d39f23f92b4585cdd VintageDreamsWaves-v2.sf2 \
      766f8b6f5716dae672ab3cab74c3d6e3ad452beb49cfef81c82b79970c2601d6 COPYRIGHT.txt \
    | sha256sum -c - \
 && ln -s VintageDreamsWaves-v2.sf2 default.sf2

CMD ["/bin/bash", "-l"]
