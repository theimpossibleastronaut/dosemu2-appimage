# Copy this file to `.env` and edit the values you want to override.
# `docker compose` automatically loads `.env` from the same folder as
# docker-compose.yml; every variable below has a sensible default, so
# the file is entirely optional.

# ---------------------------------------------------------------------------
# Which variant to build
# ---------------------------------------------------------------------------
# Leave DOSEMU_VARIANT unset (or empty) to build the Ubuntu + dosemu2 PPA
# image (Dockerfile, fast). Set it to `git` for the Arch + upstream git
# image (Dockerfile.git, slow — compiles dosemu2 *and* all AUR helpers).
# The same variable selects both the Dockerfile and the image tag, so the
# two variants never overwrite each other:
#   unset/empty → Dockerfile,     dosemu2:ppa
#   git         → Dockerfile.git, dosemu2:git
DOSEMU_VARIANT=

# ---------------------------------------------------------------------------
# Git build options (only used when DOSEMU_VARIANT=git)
# ---------------------------------------------------------------------------
# Branch, tag, or commit SHA to check out before building.
DOSEMU2_REF=devel

# Repository to clone. Point this at a fork to build your own changes.
DOSEMU2_REPO=https://github.com/dosemu2/dosemu2.git

# Build parallelism. Leave blank to auto-detect via nproc inside the
# buildkit builder. If buildkit's cgroup CPU limit makes nproc report
# fewer cores than your host actually has, set this to your real core
# count, e.g. JOBS=8.
JOBS=

# ---------------------------------------------------------------------------
# Image / container naming
# ---------------------------------------------------------------------------
# Leave DOSEMU_IMAGE unset to get `dosemu2:${DOSEMU_VARIANT:-ppa}` automatically.
# Set it to override the full image name (useful for pushing to a registry).
#DOSEMU_IMAGE=myregistry.example.com/dosemu2:latest
DOSEMU_CONTAINER=dosemu2

# ---------------------------------------------------------------------------
# Where to keep your DOS files (drive_c, config, boot.log)
# ---------------------------------------------------------------------------
# Leave the default (`dosemu-home`) to use a docker-managed named volume.
# Set it to a host path like `./dosemu-home` or `/home/you/dosemu-home`
# to use a bind mount instead — that makes it easy to drop DOS programs
# into drive_c/ from your normal file manager.
DOSEMU_HOME=dosemu-home
